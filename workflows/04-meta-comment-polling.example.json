      ],
      "id": "ee7400c9-c687-4fe0-ab3a-c9c81d1edffd",
      "name": "Schedule - Quét comment mỗi phút"
    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v25.0/YOUR_PAGE_ID/published_posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,message,created_time,comments.limit(50){id,message,from,created_time}"
            },
            {
              "name": "limit",
              "value": "10"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -640,
        -80
      ],
      "id": "84d73ddb-ebfa-42fe-8cab-1381b5a9297d",
      "name": "HTTP - Lấy bài viết và comment"
    },
    {
      "parameters": {
        "jsCode": "const pageId = 'YOUR_PAGE_ID';\n\nconst response = $input.first().json;\n\nconst posts = Array.isArray(response.data)\n  ? response.data\n  : [];\n\nconst results = [];\n\nfor (const post of posts) {\n  const comments = Array.isArray(post.comments?.data)\n    ? post.comments.data\n    : [];\n\n  for (const comment of comments) {\n    const commentId = String(comment.id ?? '');\n\n    const commentText = String(\n      comment.message ?? ''\n    ).trim();\n\n    if (!commentId || !commentText) {\n      continue;\n    }\n\n    const metaUserId = String(\n      comment.from?.id ?? ''\n    );\n\n    const customerName = String(\n      comment.from?.name ?? 'Khách Facebook'\n    );\n\n    // Bỏ comment do chính Page đăng.\n    if (metaUserId === pageId) {\n      continue;\n    }\n\n    results.push({\n  json: {\n    source: 'Facebook',\n    interaction_type: 'Comment',\n    event_type: 'comment',\n\n    page_id: pageId,\n    post_id: String(post.id ?? ''),\n    post_message: String(post.message ?? ''),\n\n    message_id: commentId,\n    message_text: commentText,\n\n    meta_user_id: metaUserId,\n    customer_name: customerName,\n\n    timestamp:\n      comment.created_time ??\n      new Date().toISOString(),\n\n    lead_key: metaUserId\n      ? `facebook:comment:${metaUserId}`\n      : `facebook:comment-id:${commentId}`,\n\n    has_user_info: Boolean(metaUserId),\n  },\n\n  pairedItem: {\n    item: 0,\n  },\n});\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -384,
        -80
      ],
      "id": "b707731b-89c1-4ad4-88ae-171c3707c08e",
      "name": "Code - Tách và chuẩn hóa Comment"
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.message_id }}",
        "options": {
          "scope": "node",
          "historySize": 10000
        }
      },
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
